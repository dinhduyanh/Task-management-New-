# Copy to backend/.env and fill in what you need. backend/.env is not committed.

# Port and allowed frontend origins (comma separated)
# PORT=4000
# FRONTEND_ORIGIN=http://localhost:5173

# AI Project Assistant (optional). Without a key the built-in rules engine answers.
# Set ONE of these; Gemini is used first when both are set.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint)
# AI_TIMEOUT_MS=20000

# Sign-up: new accounts from the Sign up page and first-time Google sign-in (default true).
# ALLOW_SIGNUP=true

# Google sign-in (optional). Create an OAuth client ID of type "Web application" in
# Google Cloud Console > APIs & Services > Credentials, and add the redirect URI below
# to its "Authorized redirect URIs".
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Where the browser returns after signing in (defaults to the first FRONTEND_ORIGIN).
# APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------------------
# Email notifications (optional)
# Each user gets emails at the address of their own TASKFLOW account. The settings below
# are only the mailbox that SENDS them. Without SMTP_HOST, emails are only written to the
# backend log. To use Gmail, remove the "#" in front of the 5 lines below and fill in:
#   SMTP_USER = the Gmail address that sends the emails
#   SMTP_PASS = a 16-character App Password of that Gmail account (NOT the normal password):
#               Google Account > Security > 2-Step Verification (turn on) > App passwords
#   MAIL_FROM = the sender name and address shown in the inbox
# Then restart the backend and test with:  npm run check:mail -- your.address@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM="TASKFLOW <your.address@gmail.com>"
#
# Other providers: set SMTP_HOST/SMTP_PORT to theirs. Port 465 uses SSL automatically;
# for 587 or 25 STARTTLS is used. Optional: MAIL_TRANSPORT=log (only log) or off (no email).
# Links in emails open the task at APP_URL (above) /?task=<id>.
