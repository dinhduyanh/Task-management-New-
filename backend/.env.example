# Copy to backend/.env and fill in what you need. backend/.env is not committed.

# Port and allowed frontend origins (comma separated)
# PORT=4000
# FRONTEND_ORIGIN=http://localhost:5173

# AI Project Assistant (optional). Without a key the built-in rules engine answers.
# Set ONE of these; Gemini is used first when both are set.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint)
# AI_TIMEOUT_MS=20000

# Sign-up: new accounts from the Sign up page and first-time Google sign-in (default true).
# ALLOW_SIGNUP=true

# Google sign-in (optional). Create an OAuth client ID of type "Web application" in
# Google Cloud Console > APIs & Services > Credentials, and add the redirect URI below
# to its "Authorized redirect URIs".
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Where the browser returns after signing in (defaults to the first FRONTEND_ORIGIN).
# APP_URL=http://localhost:5173

# Email notifications (optional). Emails are sent in the background by a queue, so a slow
# or unreachable mail server never delays the app; failed emails are retried 5 times.
# Each user is emailed at the address of their own account; users without a valid address
# (empty, malformed or a demo domain such as example.com) only get in-app notifications.
# SMTP_USER/SMTP_PASS is the account that SENDS the emails, not the recipient.
# Without SMTP_HOST the emails are only written to the server log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<your Gmail address> and
# SMTP_PASS=<an App Password from Google Account > Security > App passwords>.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        (true for port 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="TASKFLOW <no-reply@example.com>"
# MAIL_TRANSPORT=smtp      (smtp | log | off)
# Links in emails open the task at APP_URL (above) /?task=<id>.
